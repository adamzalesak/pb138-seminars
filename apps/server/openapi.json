{
  "openapi": "3.1.0",
  "info": {
    "title": "PB138 REST API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Student": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "uco": {
            "type": "string"
          },
          "enrolledCourseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "uco",
          "enrolledCourseIds"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "CreateStudentBody": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "uco": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email",
          "uco"
        ]
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "credits": {
            "type": "integer"
          },
          "instructorId": {
            "type": "string"
          },
          "semester": {
            "type": "string",
            "enum": [
              "fall",
              "spring"
            ]
          },
          "year": {
            "type": "integer"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capacity": {
            "type": "integer"
          },
          "enrolled": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "description",
          "credits",
          "instructorId",
          "semester",
          "year",
          "tags",
          "capacity",
          "enrolled"
        ]
      },
      "CreateCourseBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "credits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "instructorId": {
            "type": "string",
            "minLength": 1
          },
          "semester": {
            "type": "string",
            "enum": [
              "fall",
              "spring"
            ]
          },
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "required": [
          "code",
          "name",
          "description",
          "credits",
          "instructorId",
          "semester",
          "year",
          "tags",
          "capacity"
        ]
      },
      "Instructor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "department": {
            "type": "string"
          },
          "courseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "department",
          "courseIds"
        ]
      },
      "CreateInstructorBody": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "department": {
            "type": "string"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email",
          "department"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/students": {
      "get": {
        "tags": [
          "Students"
        ],
        "operationId": "getStudents",
        "description": "Returns all students. Optionally filter by enrolled course.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "courseId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "List of students",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Student"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Students"
        ],
        "operationId": "createStudent",
        "description": "Creates a new student. Validates email format and UCO (must be exactly 6 digits).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStudentBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          }
        }
      }
    },
    "/students/{id}": {
      "get": {
        "tags": [
          "Students"
        ],
        "operationId": "getStudentById",
        "description": "Returns a single student by ID.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The student",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "404": {
            "description": "Student not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/courses": {
      "get": {
        "tags": [
          "Courses"
        ],
        "operationId": "getCourses",
        "description": "Returns all courses. Supports optional filtering via query parameters.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "fall",
                "spring"
              ]
            },
            "required": false,
            "name": "semester",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "tags",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "required": false,
            "name": "minCredits",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "required": false,
            "name": "maxCredits",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "instructorId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "List of courses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Course"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Courses"
        ],
        "operationId": "createCourse",
        "description": "Creates a new course. The request body is validated by Zod.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCourseBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Course created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            }
          }
        }
      }
    },
    "/courses/{id}": {
      "get": {
        "tags": [
          "Courses"
        ],
        "operationId": "getCourseById",
        "description": "Returns a single course by its ID.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The course",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            }
          },
          "404": {
            "description": "Course not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/instructors": {
      "get": {
        "tags": [
          "Instructors"
        ],
        "operationId": "getInstructors",
        "description": "Returns all instructors.",
        "responses": {
          "200": {
            "description": "List of instructors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Instructor"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Instructors"
        ],
        "operationId": "createInstructor",
        "description": "Creates a new instructor.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInstructorBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Instructor created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Instructor"
                }
              }
            }
          }
        }
      }
    },
    "/instructors/{id}": {
      "get": {
        "tags": [
          "Instructors"
        ],
        "operationId": "getInstructorById",
        "description": "Returns a single instructor by ID.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The instructor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Instructor"
                }
              }
            }
          },
          "404": {
            "description": "Instructor not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
